# Apptainer definition file for deviation rating reproduction.
#
# This workload is CPU-only and only needs a minimal Python base image.

Bootstrap: docker
From: python:3.11-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        git curl wget \
        && rm -rf /var/lib/apt/lists/*

    mkdir -p /home/user/data
    mkdir -p /home/user/checkpoints
    mkdir -p /home/user/pkgs
    mkdir -p /home/user/scoring
    chmod 755 /home/user


    # --- Merged from setup.sh ---
    pip install --break-system-packages uv 2>/dev/null || pip install uv 2>/dev/null || true
    export UV_SYSTEM_PYTHON=1 UV_BREAK_SYSTEM_PACKAGES=1
    # Install runtime Python deps into /home/user/pkgs.
    # The container overlay is not writable at /usr/local during setup, so we
    # install into the workspace and expose it through PYTHONPATH.
    
    set -e
    
    export UV_CACHE_DIR=/tmp/uv_cache
    mkdir -p /home/user/pkgs
    
    uv pip install --target /home/user/pkgs numpy scipy

%environment
    export HOME=/home/user
    export PYTHONUNBUFFERED=1
    export PYTHONPATH=/home/user/pkgs:$PYTHONPATH

%startscript
    if [ -n "$PYTHONPATH" ]; then
        export PYTHONPATH=/home/user/pkgs:$PYTHONPATH
    fi
