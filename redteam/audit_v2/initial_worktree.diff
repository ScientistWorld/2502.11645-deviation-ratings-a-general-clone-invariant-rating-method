90\t        ]\n91\t        self._scale = max(1.0, max(abs(v) for t in self.tables for v in t))\n92\t\n93\t    @classmethod\n94\t    def from_function(cls, dims: Sequence[int], fn: Callable[[int, Tuple[int, ...]], float]) -> \"Game\":\n95\t        dims = tuple(int(d) for d in dims)\n96\t        joints = list(itertools.product(*[range(d) for d in dims]))\n97\t        return cls(dims, [[float(fn(p, joint)) for joint in joints] for p in range(len(dims))])\n98\t\n99\t    def index(self, joint: Sequence[int]) -> int:\n100\t        return sum(a * s for a, s in zip(joint, self.strides))\n101\t\n102\t    def value(self, player: int, joint: Sequence[int]) -> float:\n103\t        return self.tables[player][self.index(joint)]\n104\t\n105\t    def scale(self) -> float:\n106\t        return self._scale\n107\t\n108\t    def payload(self) -> list:\n109\t        def nest(table: List[float], depth: int, offset: int):\n110\t            if depth == self.n:\n111\t                return table[offset]\n112\t            return [nest(table, depth + 1, offset + a * self.strides[depth]) for a in range(self.dims[depth])]\n113\t\n114\t        return [nest(self.tables[p], 0, 0) for p in range(self.n)]\n115\t\n116\t\n117\tdef identity_maps(game: Game) -> List[List[int]]:\n118\t    return [list(range(d)) for d in game.dims]\n119\t\n120\t\n121\tdef compose_maps(first: List[List[int]], second: List[List[int]]) -> List[List[int]]:\n122\t    \"\"\"Map original actions through ``first`` and then ``second``.\"\"\"\n123\t    return [[second[p][pos] for pos in first[p]] for p in range(len(first))]\n124\t\n125\t\n126\tdef permute_actions(game: Game, perms: List[List[int]]) -> Tuple[Game, List[List[int]]]:\n127\t    \"\"\"``perms[p][new_position] = old_action``; returns the game and old->new maps.\"\"\"\n128\t    new = Game.from_function(\n129\t        game.dims, lambda p, joint: game.value(p, tuple(perms[q][joint[q]] for q in range(game.n)))\n130\t    )\n131\t    inverse = [[0] * d for d in game.dims]\n132