feedback, path):\n        ip, iv, sp, mb, mi, nr = self.params\n        if n is None:\n            info = self._info(0, (\"items\",), mi + 1, depth)\n            node = self._new_node(0, info, depth)\n            for a in range(mi + 1):\n                self.node_children[node].append(self._build(depth + 1, a, (), (), path + ((0, info, a),)))\n            return node\n        if len(bribes) == len(feedback):\n            if len(bribes) == nr:\n                node = self._new_node(-1, -1, depth)\n                t = len(self.term_payoffs[0])\n                self.node_terminal[node] = t\n                bribe, inspect = bribes[-1], feedback[-1]\n                if inspect:\n                    pay = (-n * ip, n * ip) if n > 0 else (sp, -sp)\n                else:\n                    pay = (n * iv - bribe, float(bribe))\n                self.term_payoffs[0].append(float(pay[0])); self.term_payoffs[1].append(float(pay[1]))\n                for p in (0, 1):\n                    self.term_paths[p].append([(i, a) for q, i, a in path if q == p])\n                return node\n            info = self._info(0, (\"bribe\", n, bribes, feedback), mb + 1, depth)\n            node = self._new_node(0, info, depth)\n            for b in range(mb + 1):\n                self.node_children[node].append(self._build(depth + 1, n, bribes + (b,), feedback, path + ((0, info, b),)))\n            return node\n        info = self._info(1, (\"inspect\", bribes, feedback), 2, depth)\n        node = self._new_node(1, info, depth)\n        for f in (0, 1):\n            self.node_children[node].append(self._build(depth + 1, n, bribes, feedback + (f,), path + ((1, info, f),)))\n        return node\n\n    def random_policy(self, rng, player):\n        pol = []\n        for k in self.info_actions[player]:\n            w = [-math.log(1.0 - rng.random()) for _ in range(k)]\n            s = math.fsum(w)\n            pol.append([x / s for x in w])\n        return pol\n\n    def realization(self, player,